# Knightdale Lawn Care - Environment Configuration Example
# Copy to .env.local for local testing. NEVER commit .env.local.

# Lead Generation Activation (Leave false by default until provider and webhook are ready)
LEAD_COLLECTION_ENABLED=false

# Server-Side Webhook Integration (Private, never exposed to client-side bundles)
QUOTE_WEBHOOK_URL=https://api.your-crm-endpoint.com/v1/leads/knightdale
QUOTE_WEBHOOK_SECRET=your_optional_webhook_secret_key_here

# SEO Production Indexing (Keep false for local/staging previews; set to true in production)
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional Analytics (Leave unset until verified property ID is provided)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
